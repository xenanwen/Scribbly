# Copy this file to .env.local and fill in the two values from
# Supabase dashboard -> Project Settings -> API
#
# ONLY the anon/publishable key belongs here. It is safe to expose in a browser
# because Row Level Security decides what it can actually read/write.
# NEVER put the service_role key in this file or anywhere in src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
