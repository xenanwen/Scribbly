# Copy this file to .env.local and fill in the two values from
# Supabase dashboard -> Project Settings -> API Keys
#
# VITE_SUPABASE_URL must be the bare project origin — no /rest/v1, no trailing
# slash. supabase-js appends the API paths itself.
#
# ONLY the anon / publishable key belongs here. It is safe to expose in a browser
# because Row Level Security decides what it can actually read or write.
# NEVER put a service_role or sb_secret_ key in this file, or anywhere in src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
